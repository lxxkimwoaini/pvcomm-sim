{
  "$defs": {
    "ClockConfig": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "integer"
        },
        "electrical_step_s": {
          "const": 1,
          "default": 1,
          "title": "Electrical Step S",
          "type": "integer"
        },
        "mode": {
          "const": "realtime",
          "default": "realtime",
          "title": "Mode",
          "type": "string"
        },
        "powerflow_step_s": {
          "const": 5,
          "default": 5,
          "title": "Powerflow Step S",
          "type": "integer"
        },
        "speed": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Speed",
          "type": "number"
        },
        "warmup_s": {
          "minimum": 0,
          "title": "Warmup S",
          "type": "integer"
        }
      },
      "required": [
        "duration_s",
        "warmup_s"
      ],
      "title": "ClockConfig",
      "type": "object"
    },
    "DeviceProfile": {
      "additionalProperties": false,
      "properties": {
        "ack_deadline_s": {
          "exclusiveMinimum": 0,
          "title": "Ack Deadline S",
          "type": "number"
        },
        "profile_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Profile Id",
          "type": "string"
        },
        "telemetry_period_s": {
          "enum": [
            2,
            5,
            10
          ],
          "title": "Telemetry Period S",
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "telemetry_period_s",
        "ack_deadline_s"
      ],
      "title": "DeviceProfile",
      "type": "object"
    },
    "Station": {
      "additionalProperties": false,
      "properties": {
        "capacity_kw": {
          "exclusiveMinimum": 0,
          "title": "Capacity Kw",
          "type": "number"
        },
        "common_address": {
          "maximum": 65534,
          "minimum": 1,
          "title": "Common Address",
          "type": "integer"
        },
        "device_profile": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Device Profile",
          "type": "string"
        },
        "feeder_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Feeder Id",
          "type": "string"
        },
        "rated_kva": {
          "exclusiveMinimum": 0,
          "title": "Rated Kva",
          "type": "number"
        },
        "region_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Region Id",
          "type": "string"
        },
        "station_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Station Id",
          "type": "string"
        }
      },
      "required": [
        "station_id",
        "region_id",
        "feeder_id",
        "device_profile",
        "common_address",
        "capacity_kw",
        "rated_kva"
      ],
      "title": "Station",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clock": {
      "$ref": "#/$defs/ClockConfig"
    },
    "device_profiles": {
      "items": {
        "$ref": "#/$defs/DeviceProfile"
      },
      "minItems": 1,
      "title": "Device Profiles",
      "type": "array"
    },
    "feeders": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Feeders",
      "type": "array"
    },
    "parameter_basis": {
      "const": "simulation_assumption",
      "title": "Parameter Basis",
      "type": "string"
    },
    "purpose": {
      "const": "foundation_validation",
      "title": "Purpose",
      "type": "string"
    },
    "regions": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/Station"
      },
      "minItems": 1,
      "title": "Stations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "parameter_basis",
    "run_id",
    "seed",
    "clock",
    "regions",
    "feeders",
    "device_profiles",
    "stations"
  ],
  "title": "FoundationConfig",
  "type": "object"
}
