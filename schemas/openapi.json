    "/api/runs/{run_key}/events": {
      "get": {
        "operationId": "events_api_runs__run_key__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_key",
            "required": true,
            "schema": {
              "title": "Run Key",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "at_ns",
            "required": true,
            "schema": {
              "minimum": 0,
              "title": "At Ns",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before Ns"
            }
          },
          {
            "in": "query",
            "name": "before_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before Id"
            }
          },
