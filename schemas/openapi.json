  "info": {
    "title": "PVComm foundation API",
    "version": "0.2.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/runs": {
      "get": {
        "operationId": "runs_api_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Runs"
      }
    },
    "/api/runs/{run_key}/snapshot": {
      "get": {
        "operationId": "snapshot_api_runs__run_key__snapshot_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_key",
            "required": true,
            "schema": {
              "title": "Run Key",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "at_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "At Ns"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "const": "M2",
              "default": "M2",
              "title": "Mode",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Snapshot"
      }
    },
    "/api/scenarios/validate": {
      "post": {
        "operationId": "validate_api_scenarios_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate"
      }
    }
  }
}
