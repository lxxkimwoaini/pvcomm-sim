{
  "$defs": {
    "CloudShadow": {
      "additionalProperties": false,
      "properties": {
        "center_s": {
          "exclusiveMinimum": 0,
          "title": "Center S",
          "type": "number"
        },
        "half_width_m": {
          "exclusiveMinimum": 0,
          "title": "Half Width M",
          "type": "number"
        },
        "model": {
          "const": "advected_grey_optical_layer",
          "title": "Model",
          "type": "string"
        },
        "optical_depth": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Optical Depth",
          "type": "number"
        },
        "speed_m_s": {
          "exclusiveMinimum": 0,
          "title": "Speed M S",
          "type": "number"
        }
      },
      "required": [
        "model",
        "optical_depth",
        "half_width_m",
        "speed_m_s",
        "center_s"
      ],
      "title": "CloudShadow",
      "type": "object"
    },
    "DeviceConfig": {
      "additionalProperties": false,
      "properties": {
        "azimuth_degrees": {
          "default": 180.0,
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Azimuth Degrees",
          "type": "number"
        },
        "connected": {
          "default": true,
          "title": "Connected",
          "type": "boolean"
        },
        "dc_ac_ratio": {
          "default": 1.2,
          "exclusiveMinimum": 0,
          "title": "Dc Ac Ratio",
          "type": "number"
        },
        "dc_loss_fraction": {
          "default": 0.14,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Dc Loss Fraction",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "eta_inv_nom": {
          "default": 0.96,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Eta Inv Nom",
          "type": "number"
        },
        "faulted": {
          "default": false,
          "title": "Faulted",
          "type": "boolean"
        },
        "gamma_pdc_per_c": {
          "default": -0.004,
          "exclusiveMaximum": 0,
          "minimum": -0.01,
          "title": "Gamma Pdc Per C",
          "type": "number"
        },
        "initial_setpoint_kw": {
          "minimum": 0,
          "title": "Initial Setpoint Kw",
          "type": "number"
        },
        "q_ramp_kvar_s": {
          "exclusiveMinimum": 0,
          "title": "Q Ramp Kvar S",
          "type": "number"
        },
        "q_target_kvar": {
          "default": 0.0,
          "title": "Q Target Kvar",
          "type": "number"
        },
        "ramp_down_kw_s": {
          "exclusiveMinimum": 0,
          "title": "Ramp Down Kw S",
          "type": "number"
        },
        "ramp_up_kw_s": {
          "exclusiveMinimum": 0,
          "title": "Ramp Up Kw S",
          "type": "number"
        },
        "rated_kva": {
          "exclusiveMinimum": 0,
          "title": "Rated Kva",
          "type": "number"
        },
        "rated_kw": {
          "exclusiveMinimum": 0,
          "title": "Rated Kw",
          "type": "number"
        },
        "station_id": {
          "title": "Station Id",
          "type": "string"
        },
        "tilt_degrees": {
          "default": 30.0,
          "maximum": 90,
          "minimum": 0,
          "title": "Tilt Degrees",
          "type": "number"
        }
      },
      "required": [
        "station_id",
        "rated_kw",
        "rated_kva",
        "ramp_up_kw_s",
        "ramp_down_kw_s",
        "q_ramp_kvar_s",
        "initial_setpoint_kw"
      ],
      "title": "DeviceConfig",
      "type": "object"
    },
    "FeederConfig": {
      "additionalProperties": false,
      "properties": {
        "hv_kv": {
          "default": 20.0,
          "exclusiveMinimum": 0,
          "title": "Hv Kv",
          "type": "number"
        },
        "line_length_km": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "title": "Line Length Km",
          "type": "number"
        },
        "line_max_i_ka": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "title": "Line Max I Ka",
          "type": "number"
        },
        "line_r_ohm_km": {
          "default": 0.125,
          "exclusiveMinimum": 0,
          "title": "Line R Ohm Km",
          "type": "number"
        },
        "line_x_ohm_km": {
          "default": 0.08,
          "exclusiveMinimum": 0,
          "title": "Line X Ohm Km",
          "type": "number"
        },
        "load_kvar_per_bus": {
          "default": 10.0,
          "minimum": 0,
          "title": "Load Kvar Per Bus",
          "type": "number"
        },
        "load_kw_per_bus": {
          "default": 50.0,
          "exclusiveMinimum": 0,
          "title": "Load Kw Per Bus",
          "type": "number"
        },
        "lv_kv": {
          "default": 0.4,
          "exclusiveMinimum": 0,
          "title": "Lv Kv",
          "type": "number"
        },
        "parameter_basis": {
          "const": "synthetic_engineering_assumption",
          "title": "Parameter Basis",
          "type": "string"
        },
        "transformer_i0_percent": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "title": "Transformer I0 Percent",
          "type": "number"
        },
        "transformer_mva": {
          "default": 0.63,
          "exclusiveMinimum": 0,
          "title": "Transformer Mva",
          "type": "number"
        },
        "transformer_pfe_kw": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "title": "Transformer Pfe Kw",
          "type": "number"
        },
        "transformer_vk_percent": {
          "default": 6.0,
          "exclusiveMinimum": 0,
          "title": "Transformer Vk Percent",
          "type": "number"
        },
        "transformer_vkr_percent": {
          "default": 1.2,
          "exclusiveMinimum": 0,
          "title": "Transformer Vkr Percent",
          "type": "number"
        }
      },
      "required": [
        "parameter_basis"
      ],
      "title": "FeederConfig",
      "type": "object"
    },
    "InterruptionConfig": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "enum": [
            5,
            20,
            60
          ],
          "title": "Duration S",
          "type": "integer"
        },
        "planned": {
          "title": "Planned",
          "type": "boolean"
        },
        "start_s": {
          "minimum": 1,
          "title": "Start S",
          "type": "integer"
        },
        "station_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Station Id",
          "type": "string"
        }
      },
      "required": [
        "station_id",
        "start_s",
        "duration_s",
        "planned"
      ],
      "title": "InterruptionConfig",
      "type": "object"
    },
    "V01Config": {
      "additionalProperties": false,
      "properties": {
        "capture_filter": {
          "default": "tcp",
          "title": "Capture Filter",
          "type": "string"
        },
        "capture_interface": {
          "const": "lo",
          "default": "lo",
          "title": "Capture Interface",
          "type": "string"
        },
        "command_after_s": {
          "minimum": 1,
          "title": "Command After S",
          "type": "integer"
        },
        "command_kw": {
          "exclusiveMinimum": 0,
          "title": "Command Kw",
          "type": "number"
        },
        "duration_s": {
          "maximum": 86400,
          "minimum": 5,
          "title": "Duration S",
          "type": "integer"
        },
        "host": {
          "const": "127.0.0.1",
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "interruption": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterruptionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameter_basis": {
          "const": "simulation_assumption",
          "title": "Parameter Basis",
          "type": "string"
        },
        "purpose": {
          "const": "iec104_lab",
          "title": "Purpose",
          "type": "string"
        },
        "release_after_s": {
          "minimum": 2,
          "title": "Release After S",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "stations": {
          "items": {
            "$ref": "#/$defs/V01StationConfig"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Stations",
          "type": "array"
        },
        "topology": {
          "default": "loopback",
          "enum": [
            "loopback",
            "isolated"
          ],
          "title": "Topology",
          "type": "string"
        },
        "warmup_s": {
          "minimum": 1,
          "title": "Warmup S",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "purpose",
        "parameter_basis",
        "run_id",
        "seed",
        "duration_s",
        "warmup_s",
        "command_after_s",
        "release_after_s",
        "command_kw",
        "stations"
      ],
      "title": "V01Config",
      "type": "object"
    },
    "V01StationConfig": {
      "additionalProperties": false,
      "properties": {
        "available_kw": {
          "exclusiveMinimum": 0,
          "title": "Available Kw",
          "type": "number"
        },
        "capacity_kw": {
          "exclusiveMinimum": 0,
          "title": "Capacity Kw",
          "type": "number"
        },
        "common_address": {
          "maximum": 65534,
          "minimum": 1,
          "title": "Common Address",
          "type": "integer"
        },
        "initial_setpoint_kw": {
          "exclusiveMinimum": 0,
          "title": "Initial Setpoint Kw",
          "type": "number"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "ramp_kw_per_s": {
          "exclusiveMinimum": 0,
          "title": "Ramp Kw Per S",
          "type": "number"
        },
        "reactive_kvar": {
          "default": 0.0,
          "title": "Reactive Kvar",
          "type": "number"
        },
        "region_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Region Id",
          "type": "string"
        },
        "station_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Station Id",
          "type": "string"
        },
        "telemetry_period_s": {
          "maximum": 10,
          "minimum": 2,
          "title": "Telemetry Period S",
          "type": "integer"
        },
        "voltage_kv": {
          "default": 0.4,
          "exclusiveMinimum": 0,
          "title": "Voltage Kv",
          "type": "number"
        }
      },
      "required": [
        "station_id",
        "region_id",
        "common_address",
        "port",
        "capacity_kw",
        "available_kw",
        "initial_setpoint_kw",
        "ramp_kw_per_s",
        "telemetry_period_s"
      ],
      "title": "V01StationConfig",
      "type": "object"
    },
    "WeatherConfig": {
      "additionalProperties": false,
      "properties": {
        "altitude_m": {
          "default": 330.63,
          "title": "Altitude M",
          "type": "number"
        },
        "cloud_shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/CloudShadow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "directory": {
          "title": "Directory",
          "type": "string"
        },
        "latitude": {
          "default": 35.4,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "default": 113.8,
          "title": "Longitude",
          "type": "number"
        },
        "sampling": {
          "const": "hourly_mean_zero_order_hold",
          "default": "hourly_mean_zero_order_hold",
          "title": "Sampling",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "const": "NASA_POWER_Hourly_huixian_20240601_30",
          "title": "Source Id",
          "type": "string"
        },
        "source_start": {
          "format": "date-time",
          "title": "Source Start",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "directory",
        "sha256",
        "source_start"
      ],
      "title": "WeatherConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "devices": {
      "items": {
        "$ref": "#/$defs/DeviceConfig"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Devices",
      "type": "array"
    },
    "electrical_step_s": {
      "const": 1,
      "default": 1,
      "title": "Electrical Step S",
      "type": "integer"
    },
    "feeder": {
      "$ref": "#/$defs/FeederConfig"
    },
    "parameter_basis": {
      "const": "simulation_assumption_not_field_calibrated",
      "title": "Parameter Basis",
      "type": "string"
    },
    "powerflow_step_s": {
      "const": 5,
      "default": 5,
      "title": "Powerflow Step S",
      "type": "integer"
    },
    "protocol": {
      "$ref": "#/$defs/V01Config"
    },
    "purpose": {
      "const": "power_protocol_development",
      "title": "Purpose",
      "type": "string"
    },
    "repeat_command_after_s": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repeat Command After S"
    },
    "schema_version": {
      "const": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "weather": {
      "$ref": "#/$defs/WeatherConfig"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "parameter_basis",
    "protocol",
    "weather",
    "devices",
    "feeder"
  ],
  "title": "V02Config",
  "type": "object"
}
